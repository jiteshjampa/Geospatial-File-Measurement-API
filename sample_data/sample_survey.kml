<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Aereo sample survey - Bengaluru</name>
    <Placemark>
      <name>Demo Survey Plot</name>
      <description>Sample polygon for testing projected area measurements.</description>
      <ExtendedData>
        <Data name="site_id"><value>BLR-DEMO-001</value></Data>
        <Data name="land_use"><value>test survey area</value></Data>
      </ExtendedData>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              77.5940,12.9710,0
              77.5950,12.9710,0
              77.5950,12.9720,0
              77.5940,12.9720,0
              77.5940,12.9710,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>Demo Access Route</name>
      <ExtendedData>
        <Data name="route_type"><value>inspection path</value></Data>
      </ExtendedData>
      <LineString>
        <coordinates>77.5938,12.9712,0 77.5943,12.9715,0 77.5952,12.9718,0</coordinates>
      </LineString>
    </Placemark>
    <Placemark>
      <name>Demo Inspection Point</name>
      <Point>
        <coordinates>77.5945,12.9715,0</coordinates>
      </Point>
    </Placemark>
  </Document>
</kml>
